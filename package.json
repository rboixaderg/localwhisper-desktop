{
  "name": "localwhisper-desktop",
  "version": "0.1.0",
  "description": "Local desktop speech-to-text app with custom Whisper models",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "generate:tray-icons": "node scripts/generate-tray-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "cat.roger.localwhisper",
    "productName": "LocalWhisper",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
