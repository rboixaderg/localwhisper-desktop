{
  "name": "localwhisper-desktop",
  "version": "1.1.0",
  "description": "Local desktop speech-to-text app with custom Whisper models",
  "main": "src/main/main.js",
  "author": "Roger Boixader Güell <rboixaderg@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rboixaderg/localwhisper-desktop"
  },
  "bugs": {
    "url": "https://github.com/rboixaderg/localwhisper-desktop/issues"
  },
  "homepage": "https://github.com/rboixaderg/localwhisper-desktop#readme",
  "keywords": [
    "whisper",
    "speech-to-text",
    "stt",
    "electron",
    "desktop",
    "offline",
    "privacy",
    "voice",
    "transcription",
    "dictation"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main/*.js src/renderer/*.js src/shared/*.js scripts/*.js test/*.js",
    "test": "node --test test/*.test.js",
    "generate:tray-icons": "node scripts/generate-tray-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cat.roger.localwhisper",
    "productName": "LocalWhisper",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "LocalWhisper needs microphone access to record and transcribe speech."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
